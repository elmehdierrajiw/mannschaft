---
import { parseVideoUrl } from '../data/videoStories';

interface Props {
  title: string;
  category: string;
  videoUrl: string;
  index?: number;
}

const { title, category, videoUrl, index = 0 } = Astro.props;
const { platform, id: videoId } = parseVideoUrl(videoUrl);
---

<div class="video-card reveal" style={`transition-delay: ${index * 110}ms`}>
  <div class="video-frame" data-video-card data-video-id={videoId} data-video-platform={platform}>
    <div class="video-poster">
      <span class="poster-texture" aria-hidden="true"></span>
      <span class="poster-badge">{category}</span>

      <button type="button" class="play-button" aria-label={`Play video: ${title}`}>
        <span class="play-ping" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>

  <div class="video-caption">
    <span class="caption-dot" aria-hidden="true"></span>
    <span>{title}</span>
  </div>
</div>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-navy-900);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .video-card:hover .video-frame {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .video-poster {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    background: linear-gradient(165deg, var(--color-navy-900) 0%, var(--color-primary) 100%);
  }

  .poster-texture {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.6px);
    background-size: 18px 18px;
    mask-image: radial-gradient(circle at 50% 30%, black 0%, transparent 75%);
    pointer-events: none;
  }

  .poster-badge {
    position: relative;
    z-index: 1;
    margin-top: 1.1rem;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy-900);
    background: var(--color-gold);
    padding: 0.35em 0.85em;
    border-radius: var(--radius-pill);
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.96);
    color: var(--color-navy-900);
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base), background var(--transition-base);
  }

  .play-button svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  .video-card:hover .play-button {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--color-gold);
  }

  .play-ping {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .play-ping {
      animation: play-ping-anim 2.6s ease-out infinite;
    }
  }

  @keyframes play-ping-anim {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    75%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-caption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-navy-900);
    padding-inline: 0.2rem;
  }

  @media (prefers-color-scheme: dark) {
    .video-caption {
      color: var(--color-text);
    }
  }

  .caption-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-gold);
  }
</style>

<script>
  function initVideoCards() {
    const cards = document.querySelectorAll<HTMLElement>('[data-video-card]');
    cards.forEach((card) => {
      const button = card.querySelector('.play-button');
      button?.addEventListener('click', () => {
        const videoId = card.dataset.videoId;
        const platform = card.dataset.videoPlatform;
        if (!videoId || !platform) return;
        const iframe = document.createElement('iframe');
        if (platform === 'youtube') {
          iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
          iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        } else {
          iframe.src = `https://player.vimeo.com/video/${videoId}?autoplay=1&title=0&byline=0&portrait=0`;
          iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        }
        iframe.setAttribute('allowfullscreen', '');
        card.innerHTML = '';
        card.appendChild(iframe);
      });
    });
  }

  initVideoCards();
  document.addEventListener('astro:page-load', initVideoCards);
</script>
