---
const partners = [
  { name: 'Goethe-Institut', logo: '/goethe-institut.png' },
  { name: 'ÖSD Prüfungszentrum', logo: '/oesd.png' },
  { name: 'TLScontact', logo: '/tlscontact.png' },
  { name: 'Bundesagentur für Arbeit', logo: '/bundesagentur-fuer-arbeit.png' },
];
---

<section class="section partners" id="partners" aria-label="Our Cooperation Partners">
  <div class="container">
    <div class="section-head centered reveal">
      <p class="eyebrow">Cooperation</p>
      <h2>Our Cooperation Partners</h2>
      <p class="lede">
        We work alongside institutions and organizations that support your journey into German
        language and professional life.
      </p>
    </div>

    <div class="partners-marquee reveal" style="transition-delay: 100ms">
      <div class="partners-track">
        {partners.map((partner) => (
          <span class="partner-tile">
            <img src={partner.logo} alt={partner.name} loading="lazy" />
          </span>
        ))}
        {partners.map((partner) => (
          <span class="partner-tile" aria-hidden="true">
            <img src={partner.logo} alt="" loading="lazy" />
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partners-marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
  }

  .partners-track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .partners-track {
      animation: partners-scroll 26s linear infinite;
    }

    .partners-marquee:hover .partners-track {
      animation-play-state: paused;
    }
  }

  @keyframes partners-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .partner-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 190px;
    height: 96px;
    padding: 1.1rem 1.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .partner-tile img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: opacity var(--transition-base), filter var(--transition-base);
  }

  .partner-tile:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-md);
  }

  .partner-tile:hover img {
    opacity: 1;
    filter: grayscale(0);
  }
</style>
