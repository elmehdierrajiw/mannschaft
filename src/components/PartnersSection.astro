---
// Placeholder tiles until real partner names and logo assets are provided.
const partners = ['Partner One', 'Partner Two', 'Partner Three', 'Partner Four', 'Partner Five', 'Partner Six'];
---

<section class="section partners" id="partners" aria-label="Our Cooperation Partners">
  <div class="container">
    <div class="section-head centered reveal">
      <p class="eyebrow">Cooperation</p>
      <h2>Our Cooperation Partners</h2>
      <p class="lede">
        We work alongside institutions and organizations that support your journey into German
        language and professional life.
      </p>
    </div>

    <div class="partners-marquee reveal" style="transition-delay: 100ms">
      <div class="partners-track">
        {partners.map((partner) => (
          <span class="partner-tile">{partner}</span>
        ))}
        {partners.map((partner) => (
          <span class="partner-tile" aria-hidden="true">{partner}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partners-marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, black 6%, black 94%, transparent 100%);
  }

  .partners-track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .partners-track {
      animation: partners-scroll 26s linear infinite;
    }

    .partners-marquee:hover .partners-track {
      animation-play-state: paused;
    }
  }

  @keyframes partners-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .partner-tile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 170px;
    height: 84px;
    padding: 0 1.25rem;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--color-text-soft);
    filter: grayscale(1);
    opacity: 0.75;
    transition: opacity var(--transition-base), filter var(--transition-base), border-color var(--transition-base),
      color var(--transition-base);
  }

  .partner-tile:hover {
    opacity: 1;
    filter: grayscale(0);
    border-color: var(--color-gold);
    color: var(--color-navy-900);
  }

  @media (prefers-color-scheme: dark) {
    .partner-tile:hover {
      color: var(--color-text);
    }
  }
</style>
