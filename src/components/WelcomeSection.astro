---
const journey = [
  {
    label: 'German Language',
    short: 'Language',
    detail: 'A1 to B2, spoken with real confidence',
    icon: 'language',
  },
  {
    label: 'Cultural Fluency',
    short: 'Culture',
    detail: 'Everyday norms and workplace etiquette',
    icon: 'culture',
  },
  {
    label: 'Career Readiness',
    short: 'Career',
    detail: 'CVs, interviews and recognition support',
    icon: 'career',
  },
];
---

<section class="welcome">
  <div class="welcome-backdrop" aria-hidden="true">
    <span class="welcome-glow welcome-glow-1"></span>
    <span class="welcome-glow welcome-glow-2"></span>
  </div>

  <div class="container welcome-grid">
    <div class="welcome-copy">
      <p class="eyebrow reveal">Welcome to Mannschaft</p>
      <h1 class="reveal" style="transition-delay: 60ms">
        More than German lessons — your bridge into professional life in Germany.
      </h1>
      <p class="lede reveal" style="transition-delay: 120ms">
        We prepare you linguistically, culturally, and practically for the working world here:
        real conversation skills, the cultural instincts that make everyday life click, and the
        know-how to walk into interviews, offices, and Ämter with confidence.
      </p>

      <ul class="journey-list">
        {journey.map((step, index) => (
          <li class="reveal" style={`transition-delay: ${180 + index * 90}ms`}>
            <span class="journey-icon" aria-hidden="true">
              {step.icon === 'language' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M4.5 5.5A2 2 0 0 1 6.5 3.5h11a2 2 0 0 1 2 2v7.4a2 2 0 0 1-2 2H9.7l-4.2 3.1v-3.1h-1a2 2 0 0 1-2-2v-7.4z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  ></path>
                  <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              )}
              {step.icon === 'culture' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5" />
                  <path d="M4 12h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  <path
                    d="M12 4c2.4 2.2 2.4 13.8 0 16M12 4c-2.4 2.2-2.4 13.8 0 16"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path>
                </svg>
              )}
              {step.icon === 'career' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="4" y="8.5" width="16" height="10.5" rx="2" stroke="currentColor" stroke-width="1.6" />
                  <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.6"></path>
                  <path d="M4 13.2h16" stroke="currentColor" stroke-width="1.6"></path>
                </svg>
              )}
            </span>
            <span class="journey-text">
              <strong>{step.label}</strong>
              <small>{step.detail}</small>
            </span>
          </li>
        ))}
      </ul>

      <div class="welcome-actions reveal" style="transition-delay: 460ms">
        <a href="/contact/" class="btn btn-primary">Start Your Journey</a>
        <a href="/about/" class="btn btn-secondary">See How We Teach</a>
      </div>
    </div>

    <div class="welcome-visual reveal" style="transition-delay: 140ms" aria-hidden="true">
      <div class="orbit">
        <span class="orbit-ring"></span>

        <svg class="orbit-lines" viewBox="0 0 100 100">
          <line x1="50" y1="50" x2="50" y2="10"></line>
          <line x1="50" y1="50" x2="82" y2="79"></line>
          <line x1="50" y1="50" x2="18" y2="79"></line>
        </svg>

        <div class="orbit-center">
          <svg viewBox="0 0 24 24" fill="none">
            <path
              d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
            ></path>
            <path
              d="M8.8 9.6l1.9 1.9 3.9-4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <strong>Ready</strong>
          <small>for Germany</small>
        </div>

        {journey.map((step, index) => (
          <div class={`orbit-node orbit-node-${step.icon}`} style={`transition-delay: ${120 + index * 110}ms`}>
            <span class="orbit-icon">
              {step.icon === 'language' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M4.5 5.5A2 2 0 0 1 6.5 3.5h11a2 2 0 0 1 2 2v7.4a2 2 0 0 1-2 2H9.7l-4.2 3.1v-3.1h-1a2 2 0 0 1-2-2v-7.4z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  ></path>
                  <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              )}
              {step.icon === 'culture' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5" />
                  <path d="M4 12h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  <path
                    d="M12 4c2.4 2.2 2.4 13.8 0 16M12 4c-2.4 2.2-2.4 13.8 0 16"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path>
                </svg>
              )}
              {step.icon === 'career' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="4" y="8.5" width="16" height="10.5" rx="2" stroke="currentColor" stroke-width="1.6" />
                  <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.6"></path>
                  <path d="M4 13.2h16" stroke="currentColor" stroke-width="1.6"></path>
                </svg>
              )}
            </span>
            <span>{step.short}</span>
          </div>
        ))}
      </div>

      <p class="orbit-caption reveal" style="transition-delay: 480ms">
        Three pillars, one outcome — <strong>a confident professional life in Germany.</strong>
      </p>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 4.5rem) clamp(3rem, 7vw, 5rem);
    background: linear-gradient(
      180deg,
      var(--color-bg) 0%,
      var(--color-gold-light) 46%,
      var(--color-primary-light) 100%
    );
  }

  .welcome-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .welcome-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
  }

  .welcome-glow-1 {
    width: 380px;
    height: 380px;
    top: -160px;
    left: -100px;
    background: radial-gradient(circle, rgba(200, 155, 60, 0.22), transparent 70%);
  }

  .welcome-glow-2 {
    width: 300px;
    height: 300px;
    bottom: -120px;
    right: -80px;
    background: radial-gradient(circle, rgba(29, 78, 137, 0.16), transparent 70%);
  }

  .welcome-grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .welcome-copy h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    max-width: 560px;
  }

  .welcome-copy .lede {
    max-width: 500px;
    margin-bottom: 0;
  }

  .journey-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 2.1rem;
  }

  .journey-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .journey-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .journey-icon svg {
    width: 20px;
    height: 20px;
  }

  .journey-text strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    color: var(--color-navy-900);
    margin-bottom: 0.15rem;
  }

  @media (prefers-color-scheme: dark) {
    .journey-text strong {
      color: var(--color-text);
    }
  }

  .journey-text small {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .welcome-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  /* Visual composition — pillars converging into one outcome */
  .welcome-visual {
    position: relative;
  }

  .orbit {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .orbit-ring {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
    border: 1.5px dashed var(--color-gold);
    opacity: 0.4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit-ring {
      animation: orbit-spin 50s linear infinite;
    }
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .orbit-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .orbit-lines line {
    stroke: var(--color-gold);
    stroke-width: 0.5;
    stroke-dasharray: 2 2.2;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit-lines line {
      opacity: 0;
      transition: opacity 0.5s var(--ease-out);
    }

    .welcome-visual.is-visible .orbit-lines line:nth-child(1) {
      transition-delay: 60ms;
    }
    .welcome-visual.is-visible .orbit-lines line:nth-child(2) {
      transition-delay: 170ms;
    }
    .welcome-visual.is-visible .orbit-lines line:nth-child(3) {
      transition-delay: 280ms;
    }

    .welcome-visual.is-visible .orbit-lines line {
      opacity: 0.55;
    }
  }

  .orbit-center {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: 37%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--color-navy-900) 0%, var(--color-primary) 100%);
    box-shadow: var(--shadow-lg);
    text-align: center;
    padding: 0.5rem;
    color: #fff;
    transform: translate(-50%, -50%);
  }

  .orbit-center::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--color-gold);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit-center {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.75);
      transition: opacity 0.55s var(--ease-out), transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s var(--ease-out);
      transition-delay: 200ms;
    }

    .welcome-visual.is-visible .orbit-center {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .welcome-visual.is-visible .orbit-center:hover {
      transform: translate(-50%, -50%) scale(1.05);
    }

    .welcome-visual.is-visible .orbit-center::before {
      animation: orbit-ping 3.4s ease-out infinite;
      animation-delay: 1.1s;
    }
  }

  @keyframes orbit-ping {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    75%,
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  .orbit-center svg {
    width: 24%;
    height: 24%;
    color: var(--color-gold);
    margin-bottom: 0.25rem;
    transition: transform 0.3s var(--ease-out);
  }

  .welcome-visual.is-visible .orbit-center:hover svg {
    transform: scale(1.12);
  }

  .orbit-center strong {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    font-weight: 700;
  }

  .orbit-center small {
    font-size: clamp(0.62rem, 1.6vw, 0.7rem);
    color: rgba(255, 255, 255, 0.75);
  }

  .orbit-node {
    position: absolute;
    z-index: 1;
    top: 79%;
    width: 28%;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(0.62rem, 1.8vw, 0.75rem);
    color: var(--color-navy-900);
    text-align: center;
    padding: 0.4rem;
    transform: translate(-50%, -50%);
    transition: border-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }

  .welcome-visual.is-visible .orbit-node:hover {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-lg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbit-node {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.7);
      transition: opacity 0.5s var(--ease-out), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
        border-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
    }

    .welcome-visual.is-visible .orbit-node {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .welcome-visual.is-visible .orbit-node:hover {
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @media (prefers-color-scheme: dark) {
    .orbit-node {
      color: var(--color-text);
    }
  }

  .orbit-node-language {
    top: 10%;
    left: 50%;
  }

  .orbit-node-culture {
    left: 82%;
  }

  .orbit-node-career {
    left: 18%;
  }

  .orbit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary);
    transition: background 0.25s var(--ease-out), color 0.25s var(--ease-out);
  }

  .orbit-icon svg {
    width: 55%;
    height: 55%;
  }

  .welcome-visual.is-visible .orbit-node:hover .orbit-icon {
    background: var(--color-gold);
    color: var(--color-navy-900);
  }

  .orbit-caption {
    max-width: 300px;
    margin: 1.8rem auto 0;
    text-align: center;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .orbit-caption strong {
    color: var(--color-navy-900);
    font-weight: 700;
  }

  @media (prefers-color-scheme: dark) {
    .orbit-caption strong {
      color: var(--color-text);
    }
  }

  @media (min-width: 960px) {
    .welcome-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
