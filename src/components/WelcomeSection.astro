---
const journey = [
  {
    label: 'German Language',
    detail: 'A1 to C1, spoken with real confidence',
    icon: 'language',
  },
  {
    label: 'Cultural Fluency',
    detail: 'Everyday norms and workplace etiquette',
    icon: 'culture',
  },
  {
    label: 'Career Readiness',
    detail: 'CVs, interviews and recognition support',
    icon: 'career',
  },
];
---

<section class="welcome">
  <div class="welcome-backdrop" aria-hidden="true">
    <span class="welcome-glow welcome-glow-1"></span>
    <span class="welcome-glow welcome-glow-2"></span>
  </div>

  <div class="container welcome-grid">
    <div class="welcome-copy">
      <p class="eyebrow reveal">Welcome to Mannschaft</p>
      <h1 class="reveal" style="transition-delay: 60ms">
        More than German lessons — your bridge into professional life in Germany.
      </h1>
      <p class="lede reveal" style="transition-delay: 120ms">
        We prepare you linguistically, culturally, and practically for the working world here:
        real conversation skills, the cultural instincts that make everyday life click, and the
        know-how to walk into interviews, offices, and Ämter with confidence.
      </p>

      <ul class="journey-list">
        {journey.map((step, index) => (
          <li class="reveal" style={`transition-delay: ${180 + index * 90}ms`}>
            <span class="journey-icon" aria-hidden="true">
              {step.icon === 'language' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path
                    d="M4.5 5.5A2 2 0 0 1 6.5 3.5h11a2 2 0 0 1 2 2v7.4a2 2 0 0 1-2 2H9.7l-4.2 3.1v-3.1h-1a2 2 0 0 1-2-2v-7.4z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  ></path>
                  <path d="M8 9h8M8 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
              )}
              {step.icon === 'culture' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5" />
                  <path d="M4 12h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                  <path
                    d="M12 4c2.4 2.2 2.4 13.8 0 16M12 4c-2.4 2.2-2.4 13.8 0 16"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path>
                </svg>
              )}
              {step.icon === 'career' && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="4" y="8.5" width="16" height="10.5" rx="2" stroke="currentColor" stroke-width="1.6" />
                  <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.6"></path>
                  <path d="M4 13.2h16" stroke="currentColor" stroke-width="1.6"></path>
                </svg>
              )}
            </span>
            <span class="journey-text">
              <strong>{step.label}</strong>
              <small>{step.detail}</small>
            </span>
          </li>
        ))}
      </ul>

      <div class="welcome-actions reveal" style="transition-delay: 460ms">
        <a href="/contact/" class="btn btn-primary">Start Your Journey</a>
        <a href="/about/" class="btn btn-secondary">See How We Teach</a>
      </div>
    </div>

    <div class="welcome-visual reveal" style="transition-delay: 160ms" aria-hidden="true">
      <span class="corner-frame"></span>

      <div class="showcase-panel">
        <div class="panel-surface">
          <span class="showcase-glow"></span>
          <span class="showcase-grid"></span>

          <p class="showcase-tag">Berlin · Your New Chapter</p>
          <p class="showcase-phrase">Auf geht&rsquo;s.</p>

          <svg class="skyline" viewBox="0 0 420 150" preserveAspectRatio="xMidYMax slice" fill="none">
            <path d="M0 150h420" stroke="currentColor" stroke-width="1.2" opacity="0.5"></path>
            <g stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
              <path d="M120 150V72M133 150V72M146 150V72M159 150V72M172 150V72M185 150V72"></path>
              <path d="M112 72h81v-9l-40.5-16-40.5 16z"></path>
              <path d="M107 150h91"></path>
            </g>
            <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M330 150V58"></path>
              <circle cx="330" cy="49" r="10"></circle>
              <path d="M321 150h18"></path>
            </g>
          </svg>
        </div>

        <div class="float-card float-card-quote">
          <div class="quote-stars">★★★★★</div>
          <p>&ldquo;I went from zero German to passing my B1 exam in eight months.&rdquo;</p>
          <div class="quote-author">
            <span class="quote-avatar">PN</span>
            <span>
              <strong>Priya Nair</strong>
              <small>Software Engineer, Bengaluru → Berlin</small>
            </span>
          </div>
        </div>

        <div class="float-card float-card-stat">
          <strong>30+</strong>
          <small>countries represented</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .welcome {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 4.5rem) clamp(3rem, 7vw, 5rem);
    background: linear-gradient(
      180deg,
      var(--color-bg) 0%,
      var(--color-gold-light) 46%,
      var(--color-primary-light) 100%
    );
  }

  .welcome-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .welcome-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
  }

  .welcome-glow-1 {
    width: 380px;
    height: 380px;
    top: -160px;
    left: -100px;
    background: radial-gradient(circle, rgba(200, 155, 60, 0.22), transparent 70%);
  }

  .welcome-glow-2 {
    width: 300px;
    height: 300px;
    bottom: -120px;
    right: -80px;
    background: radial-gradient(circle, rgba(29, 78, 137, 0.16), transparent 70%);
  }

  .welcome-grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .welcome-copy h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    max-width: 560px;
  }

  .welcome-copy .lede {
    max-width: 500px;
    margin-bottom: 0;
  }

  .journey-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 2.1rem;
  }

  .journey-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .journey-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .journey-icon svg {
    width: 20px;
    height: 20px;
  }

  .journey-text strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    color: var(--color-navy-900);
    margin-bottom: 0.15rem;
  }

  @media (prefers-color-scheme: dark) {
    .journey-text strong {
      color: var(--color-text);
    }
  }

  .journey-text small {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .welcome-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  /* Visual composition */
  .welcome-visual {
    position: relative;
    min-height: 380px;
    padding-block: 2.75rem;
  }

  .corner-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(440px, 90%);
    height: 420px;
    max-height: 90%;
    border: 1px solid var(--color-gold);
    border-radius: var(--radius-lg);
    opacity: 0.3;
    transform: translate(-50%, -50%) rotate(-4deg);
  }

  .showcase-panel {
    position: relative;
    z-index: 1;
    max-width: 420px;
    margin-inline: auto;
  }

  .panel-surface {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    padding: 2.1rem 2rem 0;
    border-radius: var(--radius-lg);
    background: linear-gradient(150deg, var(--color-navy-900) 0%, var(--color-primary) 100%);
    box-shadow: var(--shadow-lg);
  }

  .showcase-glow {
    position: absolute;
    top: -70px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 155, 60, 0.38), transparent 70%);
    pointer-events: none;
  }

  .showcase-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1.6px);
    background-size: 20px 20px;
    mask-image: linear-gradient(180deg, black, transparent 70%);
    pointer-events: none;
  }

  .showcase-tag {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin: 0 0 0.85rem;
  }

  .showcase-phrase {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    margin: 0 0 2.5rem;
  }

  .skyline {
    position: absolute;
    z-index: 0;
    left: -6%;
    right: -6%;
    bottom: 0;
    width: 112%;
    height: 46%;
    color: rgba(244, 230, 198, 0.28);
    pointer-events: none;
  }

  .float-card {
    display: none;
    position: absolute;
    z-index: 2;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 0.85rem 1rem;
  }

  .float-card-quote {
    bottom: -34px;
    left: 6%;
    max-width: 230px;
  }

  .quote-stars {
    color: var(--color-gold);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.4rem;
  }

  .float-card-quote p {
    font-size: 0.82rem;
    color: var(--color-navy-900);
    line-height: 1.4;
    margin: 0 0 0.7rem;
  }

  @media (prefers-color-scheme: dark) {
    .float-card-quote p {
      color: var(--color-text);
    }
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .quote-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .quote-author strong {
    display: block;
    font-size: 0.78rem;
    color: var(--color-navy-900);
  }

  @media (prefers-color-scheme: dark) {
    .quote-author strong {
      color: var(--color-text);
    }
  }

  .quote-author small {
    font-size: 0.7rem;
    color: var(--color-text-soft);
  }

  .float-card-stat {
    top: -22px;
    right: -20px;
    text-align: center;
  }

  .float-card-stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-navy-900);
  }

  @media (prefers-color-scheme: dark) {
    .float-card-stat strong {
      color: var(--color-text);
    }
  }

  .float-card-stat small {
    font-size: 0.72rem;
    color: var(--color-text-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .float-card-quote,
    .float-card-stat {
      animation: welcome-float 6.5s ease-in-out infinite;
    }
    .float-card-stat {
      animation-delay: 1.4s;
    }
  }

  @keyframes welcome-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  @media (min-width: 960px) {
    .welcome-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .float-card {
      display: block;
    }
  }
</style>
