---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy policy for Mannschaft Sprachzentrum."
  path="/legal/privacy/"
>
  <section class="section legal-content">
    <div class="container prose">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p>
        This page explains what information {SITE.fullName} collects when you use this website
        and how it is used.
      </p>

      <h2>Information we collect</h2>
      <p>
        When you submit our contact form, we collect the name, email address, phone number, and
        message you provide, solely to respond to your enquiry.
      </p>

      <h2>How we use your information</h2>
      <p>
        We use your contact details only to communicate with you about course information,
        enrollment, and related administrative matters. We do not sell or share your data with
        third parties for marketing purposes.
      </p>

      <h2>Data retention</h2>
      <p>
        Enquiry data is retained only as long as necessary to respond to your request and
        maintain accurate business records, after which it is deleted.
      </p>

      <h2>Your rights</h2>
      <p>
        You may request access to, correction of, or deletion of your personal data at any time
        by contacting us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-content {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .prose {
    max-width: 680px;
  }

  .prose h1 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .prose h2 {
    font-size: 1.2rem;
    margin-top: 2rem;
  }
</style>
