---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
---

<BaseLayout
  title="Imprint"
  description="Legal imprint (Impressum) for Mannschaft Sprachzentrum."
  path="/legal/imprint/"
>
  <section class="section legal-content">
    <div class="container prose">
      <p class="eyebrow">Legal</p>
      <h1>Imprint</h1>
      <p>Information according to § 5 TMG.</p>

      <h2>Operator</h2>
      <p>
        {SITE.fullName}<br />
        {SITE.address}
      </p>

      <h2>Contact</h2>
      <p>
        Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br />
        Phone: <a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
      </p>

      <h2>Responsible for content</h2>
      <p>
        {SITE.fullName} is responsible for the content of this website in accordance with § 55
        Abs. 2 RStV.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-content {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .prose {
    max-width: 680px;
  }

  .prose h1 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }

  .prose h2 {
    font-size: 1.2rem;
    margin-top: 2rem;
  }
</style>
