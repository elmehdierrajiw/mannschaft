---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mannschaft Sprachzentrum. Request course information, book a placement conversation, or ask a question — we reply within one business day."
  path="/contact/"
>
  <PageHero
    eyebrow="Contact"
    title="Let's find your right course"
    description="Tell us a little about your goals and current level. A learning advisor will get back to you within one business day."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-form-wrap reveal">
        <form
          class="contact-form"
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          data-contact-form
        >
          <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="form-row two-col">
            <div>
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div>
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <div class="form-row">
            <label for="interest">I'm interested in</label>
            <select id="interest" name="interest" required>
              <option value="">Select an option</option>
              <option value="german-a1-b2">German Course (A1–B2)</option>
              <option value="exam-prep">Exam Preparation</option>
              <option value="language-courses">Other Language Course</option>
              <option value="corporate">Private / Corporate Coaching</option>
              <option value="other">Something else</option>
            </select>
          </div>

          <div class="form-row">
            <label for="message">Your message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Send Message</button>
          <p class="form-note" role="status" data-form-status></p>
        </form>
      </div>

      <div class="contact-info reveal">
        <div class="info-block">
          <h3>Visit us</h3>
          <p>{SITE.address}</p>
        </div>
        <div class="info-block">
          <h3>Email</h3>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <div class="info-block">
          <h3>Phone</h3>
          <p><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></p>
        </div>
        <div class="info-block">
          <h3>Office hours</h3>
          <p>Monday – Friday, 9:00 – 18:00<br />Saturday, 10:00 – 14:00</p>
        </div>
        <div class="map-placeholder" aria-hidden="true">
          <svg width="100%" height="100%" viewBox="0 0 320 200" preserveAspectRatio="none">
            <rect width="320" height="200" fill="var(--color-primary-light)" />
            <path d="M0 140 Q80 100 160 140 T320 130" stroke="var(--color-primary)" stroke-width="2" fill="none" opacity="0.4" />
            <circle cx="160" cy="90" r="7" fill="var(--color-gold)" />
            <path d="M160 90 v-22" stroke="var(--color-gold)" stroke-width="2" />
          </svg>
          <span>Friedrichstraße 68, Berlin</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-form {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-row.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-row.two-col > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.75em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px var(--color-gold-light);
  }

  textarea {
    resize: vertical;
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    margin: 0;
    min-height: 1.2em;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-block h3 {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-soft);
    margin-bottom: 0.35rem;
  }

  .info-block p {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text);
  }

  .map-placeholder {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 160px;
  }

  .map-placeholder span {
    position: absolute;
    bottom: 0.8rem;
    left: 0.9rem;
    background: var(--color-surface);
    padding: 0.4em 0.8em;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 960px) {
    .contact-grid { grid-template-columns: 1.4fr 1fr; }
  }

  @media (max-width: 560px) {
    .form-row.two-col { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form && status) {
    form.addEventListener('submit', () => {
      status.textContent = 'Sending your message…';
    });
  }
</script>
